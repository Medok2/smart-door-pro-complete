# Smart Door Pro - Backend Environment Configuration

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_door_pro
DB_USER=root
DB_PASSWORD=

# Server
APP_NAME=Smart Door Pro
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=Africa/Cairo
APP_LANGUAGE=ar

# API
API_VERSION=v1
API_BASE_PATH=/api
API_PORT=443

# Security
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# Device
DEVICE_SECRET=your_device_secret_key_here_min_32_chars
DEVICE_HEARTBEAT_TIMEOUT=120
DEVICE_COMMAND_TIMEOUT=10
DEVICE_POLL_INTERVAL=2

# Door Settings
DOOR_NAME=Main Door
DOOR_UNLOCK_DURATION=3000
DOOR_RELAY_ACTIVE_LEVEL=HIGH
DOOR_MIN_UNLOCK_DURATION=500
DOOR_MAX_UNLOCK_DURATION=15000

# Access Control
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900
COOLDOWN_SECONDS=10
MAX_CONCURRENT_USERS=90

# Guest Passes
GUEST_PASS_TOKEN_LENGTH=32
GUEST_PASS_DEFAULT_EXPIRY=86400
QR_CODE_TYPE=url

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Notifications
NOTIFICATION_ENABLED=true
PUSH_NOTIFICATION_ENABLED=false
EMAIL_ENABLED=false
TELEGRAM_ENABLED=false

# Telegram Bot (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# Operating Modes
OPERATING_MODE=server
LOCAL_MODE_ENABLED=true
SERVER_MODE_ENABLED=true
TELEGRAM_MODE_ENABLED=false

# Local Network
LOCAL_NETWORK_SSID=SmartDoor-Device
LOCAL_NETWORK_PASSWORD=smartdoor123456
LOCAL_API_PORT=8080
LOCAL_API_TIMEOUT=5

# Logging
LOG_LEVEL=info
LOG_FILE=storage/logs/app.log
AUDIT_LOG_ENABLED=true
ACCESS_LOG_ENABLED=true

# Storage
STORAGE_PATH=storage/
STORAGE_LOGS=storage/logs/
STORAGE_UPLOADS=storage/uploads/

# CORS
CORS_ENABLED=true
CORS_ORIGINS=localhost:3000,yourdomain.com

# Developer
DEVELOPER_NAME=A.K
DEVELOPER_PHONE=+201117614245
DEVELOPER_WEBSITE=https://example.com
